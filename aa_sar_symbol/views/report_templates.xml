<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Company report layouts: prepend the riyal font to the chosen layout font -->
    <template id="styles_company_report" inherit_id="web.styles_company_report">
        <xpath expr="//t[@t-esc='font']" position="attributes">
            <attribute name="t-esc">'Saudi Riyal Symbol, ' + font</attribute>
        </xpath>
    </template>

</odoo>
