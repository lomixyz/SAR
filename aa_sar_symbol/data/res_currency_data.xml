<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- New Saudi Riyal sign (Unicode U+20C1), displayed before the amount -->
    <function model="res.currency" name="write">
        <value eval="[ref('base.SAR')]"/>
        <value eval="{'symbol': '⃁', 'position': 'before'}"/>
    </function>

</odoo>
